{{define "subject"}}Activate your GopherSocial account{{end}}
{{define "body"}}
<!doctype html>
<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>Activate your GopherSocial account</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap');

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        background-color: #0a0a0f;
        font-family: 'DM Sans', sans-serif;
        color: #e8e8f0;
        padding: 40px 16px;
        -webkit-font-smoothing: antialiased;
      }

      .wrapper {
        max-width: 560px;
        margin: 0 auto;
      }

      /* ── Header ── */
      .header {
        text-align: center;
        margin-bottom: 32px;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        vertical-align: middle;
      }

      .logo-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, #00d2ff, #7b2ff7);
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        font-size: 18px;
      }

      .logo-text {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 20px;
        color: #ffffff;
        letter-spacing: -0.5px;
      }

      /* ── Card ── */
      .card {
        background: #13131f;
        border: 1px solid #1e1e30;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03);
      }

      .card-top {
        background: linear-gradient(135deg, #0d1b3e 0%, #1a0a2e 50%, #0d1b3e 100%);
        padding: 48px 40px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }

      .card-top::before {
        content: '';
        position: absolute;
        top: -60px; left: 50%;
        transform: translateX(-50%);
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(0,210,255,0.12) 0%, transparent 70%);
        pointer-events: none;
      }

      .card-top::after {
        content: '';
        position: absolute;
        bottom: -40px; right: -40px;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(123,47,247,0.15) 0%, transparent 70%);
        pointer-events: none;
      }

      .gopher-emoji {
        font-size: 52px;
        display: block;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
      }

      .card-top h1 {
        font-family: 'Syne', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.8px;
        line-height: 1.2;
        position: relative;
        z-index: 1;
        margin-bottom: 12px;
      }

      .card-top h1 span {
        background: linear-gradient(90deg, #00d2ff, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .card-top p {
        color: #8888aa;
        font-size: 15px;
        font-weight: 300;
        position: relative;
        z-index: 1;
      }

      /* ── Body ── */
      .card-body {
        padding: 36px 40px;
      }

      .greeting {
        font-size: 16px;
        color: #c0c0d8;
        margin-bottom: 24px;
        line-height: 1.6;
      }

      .greeting strong {
        color: #ffffff;
        font-weight: 500;
      }

      /* ── Divider ── */
      .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, #1e1e30, transparent);
        margin: 28px 0;
      }

      /* ── Steps ── */
      .steps-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #555570;
        margin-bottom: 16px;
      }

      .step {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 14px;
      }

      .step-num {
        width: 24px; height: 24px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00d2ff22, #7b2ff722);
        border: 1px solid #00d2ff44;
        display: inline-block;
        text-align: center;
        line-height: 24px;
        font-size: 11px;
        font-weight: 700;
        color: #00d2ff;
        flex-shrink: 0;
      }

      .step-text {
        font-size: 14px;
        color: #9090b0;
        line-height: 1.5;
      }

      .step-text strong { color: #c8c8e0; font-weight: 500; }

      /* ── CTA Button ── */
      .cta-wrap {
        text-align: center;
        margin: 32px 0;
      }

      .cta-btn {
        display: inline-block;
        padding: 16px 40px;
        background: linear-gradient(135deg, #00d2ff, #7b2ff7);
        color: #ffffff !important;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.3px;
        text-decoration: none;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 210, 255, 0.25), 0 2px 8px rgba(0,0,0,0.4);
      }

      .expiry-note {
        text-align: center;
        font-size: 12px;
        color: #555570;
        margin-top: 12px;
      }

      .expiry-note span {
        color: #f59e0b;
        font-weight: 500;
      }

      /* ── Footer ── */
      .card-footer {
        background: #0e0e1a;
        border-top: 1px solid #1a1a28;
        padding: 24px 40px;
      }

      .fallback-url {
        font-size: 11px;
        color: #44445a;
        word-break: break-all;
        line-height: 1.6;
      }

      .fallback-url a {
        color: #00d2ff88;
        text-decoration: none;
      }

      .ignore-note {
        margin-top: 16px;
        font-size: 12px;
        color: #44445a;
        line-height: 1.6;
      }

      /* ── Bottom ── */
      .bottom {
        text-align: center;
        margin-top: 28px;
        font-size: 12px;
        color: #333348;
        line-height: 1.8;
      }

      .bottom a { color: #444460; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <!-- Card -->
      <div class="card">

        <!-- Top banner -->
        <div class="card-top">
          <h1>Welcome to <span>GopherSocial</span></h1>
          <p>One step away from joining the community</p>
        </div>

        <!-- Body -->
        <div class="card-body">

          <p class="greeting">
            Hey <strong>{{.Username}}</strong>, thanks for signing up!<br>
            Your account is ready — just click the button below to verify your email and activate it.
          </p>

          <div class="divider"></div>

          <p class="steps-label">What happens next</p>

          <div class="step">
            <div class="step-num">1</div>
            <div class="step-text"><strong>Activate your account</strong> by clicking the button below</div>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <div class="step-text"><strong>Complete your profile</strong> and add a bio</div>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <div class="step-text"><strong>Connect with other Gophers</strong> and start posting</div>
          </div>

          <div class="divider"></div>

          <!-- CTA -->
          <div class="cta-wrap">
            <a href="{{.ActivationURL}}" class="cta-btn">Activate My Account →</a>
            <p class="expiry-note">This link expires in <span>3 days</span></p>
          </div>

        </div>

        <!-- Footer -->
        <div class="card-footer">
          <p class="fallback-url">
            Button not working? Copy and paste this link into your browser:<br>
            <a href="{{.ActivationURL}}">{{.ActivationURL}}</a>
          </p>
          <p class="ignore-note">
            If you didn't create a GopherSocial account, you can safely ignore this email. Someone may have entered your address by mistake.
          </p>
        </div>

      </div>

      <!-- Bottom -->
      <div class="bottom">
        © 2025 GopherSocial · <a href="#">Unsubscribe</a> · <a href="#">Privacy Policy</a><br>
        Sent with ❤️ by the GopherSocial Team (APRIL)
      </div>

    </div>
  </body>
</html>
{{end}}
